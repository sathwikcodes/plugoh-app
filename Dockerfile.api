FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/mobile/package.json ./apps/mobile/package.json
COPY services/api/package.json ./services/api/package.json
COPY services/jobs/package.json ./services/jobs/package.json
COPY packages/config/package.json ./packages/config/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY packages/db/package.json ./packages/db/package.json

RUN npm ci --include-workspace-root=false --workspace @plugoh/contracts --workspace @plugoh/api

COPY packages/config ./packages/config
COPY packages/contracts ./packages/contracts
COPY services/api ./services/api

RUN npm run --workspace @plugoh/contracts build
RUN npm run --workspace @plugoh/api build

RUN mkdir -p /packs
RUN npm pack ./packages/contracts --pack-destination /packs
RUN npm pack ./services/api --pack-destination /packs

RUN mkdir -p /runtime
RUN printf '%s\n' '{"name":"plugoh-api-runtime","private":true}' > /app/runtime-package.json
RUN cp /app/runtime-package.json /runtime/package.json
RUN cd /runtime && npm install --omit=dev /packs/plugoh-contracts-1.0.0.tgz /packs/plugoh-api-1.0.0.tgz

FROM gcr.io/distroless/nodejs22-debian12 AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

COPY --from=build /runtime/package.json ./package.json
COPY --from=build /runtime/node_modules ./node_modules

USER nonroot
EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=3s CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:4000/healthz/live').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

CMD ["node_modules/@plugoh/api/dist/index.js"]
