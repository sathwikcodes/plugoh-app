FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/mobile/package.json ./apps/mobile/package.json
COPY services/ai/package.json ./services/ai/package.json
COPY services/api/package.json ./services/api/package.json
COPY services/jobs/package.json ./services/jobs/package.json
COPY packages/config/package.json ./packages/config/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY packages/db/package.json ./packages/db/package.json

RUN npm ci --include-workspace-root=false --workspace @plugoh/contracts --workspace @plugoh/api

COPY packages/config ./packages/config
COPY packages/contracts ./packages/contracts
COPY services/api ./services/api

RUN npm run --workspace @plugoh/contracts build
RUN npm run --workspace @plugoh/api build
RUN mkdir -p /packs
RUN npm pack ./packages/contracts --pack-destination /packs
RUN npm pack ./services/api --pack-destination /packs

FROM node:22-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

COPY --from=build /packs/*.tgz /packs/
RUN printf '%s\n' '{"name":"plugoh-api-runtime","private":true}' > package.json
RUN npm install --omit=dev /packs/plugoh-contracts-1.0.0.tgz /packs/plugoh-api-1.0.0.tgz

EXPOSE 4000

CMD ["node", "node_modules/@plugoh/api/dist/index.js"]
