# Plugoh mobile local environment
# Copy this file to apps/mobile/.env and fill in the values.
# Expo automatically loads EXPO_PUBLIC_* variables for the app at runtime.

# Mobile app -> Hono API base URL
# Keep localhost here for local simulators. On a physical device in dev, the app
# automatically swaps localhost for your laptop's LAN IP (same Wi‑Fi as Metro).
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# Supabase client auth / session config for mobile
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: EAS project id if you want Expo push token registration to work locally
# EXPO_PUBLIC_EAS_PROJECT_ID=

# Razorpay publishable key used by native checkout flow
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# Required for Expo Maps on Android development/builds.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
