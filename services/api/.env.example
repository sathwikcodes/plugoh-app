# Plugoh API local environment
# Copy to services/api/.env and fill values locally. Do not commit services/api/.env.

# Server
PORT=4000
CORS_ORIGIN=*

# Supabase
# NEXT_PUBLIC_SUPABASE_URL can also be used as a fallback for SUPABASE_URL.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY can also be used as a fallback for SUPABASE_ANON_KEY.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Instagram OAuth
# INSTAGRAM_APP_ID can also be used as a fallback for INSTAGRAM_CLIENT_ID.
# NEXT_PUBLIC_INSTAGRAM_REDIRECT_URI can also be used as a fallback for INSTAGRAM_REDIRECT_URI.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:4000/auth/callback/instagram

# AI providers
# GOOGLE_AI_API_KEY can also be used as a fallback for GOOGLE_AI_KEY.
ANTHROPIC_API_KEY=
GOOGLE_AI_KEY=

# Location geocoding
# GOOGLE_MAPS_API_KEY can also be used as a fallback.
GOOGLE_MAPS_GEOCODING_API_KEY=

# Optional location weather for campaign detail pages.
# GOOGLE_MAPS_API_KEY can also be used as a fallback.
GOOGLE_MAPS_WEATHER_API_KEY=

# Internal API protection
INTERNAL_SECRET=
CRON_SECRET=

# Optional demo endpoint
NEXT_PUBLIC_DEMO_ENABLED=false
