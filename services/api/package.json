{
  "name": "@plugoh/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jobs": {
      "types": "./dist/jobs/run-auto-release.d.ts",
      "default": "./dist/jobs/run-auto-release.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "request": "hono request src/request-app.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@hono/zod-validator": "^0.7.6",
    "@plugoh/contracts": "^1.0.0",
    "@supabase/supabase-js": "^2.105.3",
    "applicationinsights": "^3.14.0",
    "dotenv": "^16.4.7",
    "hono": "^4.6.9",
    "hono-rate-limiter": "^0.5.3",
    "ioredis": "^5.10.1",
    "p-retry": "^6.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "razorpay": "^2.9.6",
    "resend": "^6.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^4.1.5",
    "pg": "^8.20.0",
    "testcontainers": "^11.14.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.5"
  }
}
