{
  "name": "plugoh",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.11 <23"
  },
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run mobile:start",
    "contracts:build": "npm run --workspace @plugoh/contracts build",
    "db:build": "npm run --workspace @plugoh/db build",
    "mobile:start": "npm run --workspace @plugoh/mobile start --",
    "mobile:android": "npm run --workspace @plugoh/mobile android --",
    "mobile:ios": "npm run --workspace @plugoh/mobile ios --",
    "mobile:web": "npm run --workspace @plugoh/mobile web --",
    "mobile:lint": "npm run --workspace @plugoh/mobile lint --",
    "mobile:test": "npm run --workspace @plugoh/mobile test --",
    "mobile:test:coverage": "npm run --workspace @plugoh/mobile test:coverage --",
    "mobile:doctor": "npm run --workspace @plugoh/mobile doctor --",
    "mobile:reset-project": "npm run --workspace @plugoh/mobile reset-project --",
    "api:dev": "npm run contracts:build && npm run --workspace @plugoh/api dev",
    "api:build": "npm run contracts:build && npm run --workspace @plugoh/api build",
    "api:test": "npm run contracts:build && npm run --workspace @plugoh/api test",
    "api:test:coverage": "npm run contracts:build && npm run --workspace @plugoh/api test:coverage",
    "create:ai-campaign": "npm run --workspace @plugoh/api create:ai-campaign --",
    "jobs:dev": "npm run --workspace @plugoh/jobs dev",
    "graphify:build": "node scripts/graphify-build.mjs",
    "lint": "npm run contracts:build && eslint --no-warn-ignored --max-warnings=0 services/**/*.ts packages/**/*.ts apps/mobile/**/*.{ts,tsx}",
    "typecheck": "npm run contracts:build && npm run db:build && npm run --workspace @plugoh/api build && npm run --workspace @plugoh/jobs build && npm run --workspace @plugoh/mobile typecheck",
    "prepare": "simple-git-hooks",
    "android": "npm run mobile:android",
    "ios": "npm run mobile:ios"
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.39.1",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "simple-git-hooks": "^2.13.1",
    "typescript-eslint": "^8.46.2"
  },
  "dependencies": {
    "expo": "~54.0.35",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "4.1.7",
    "react-native-worklets": "0.5.1"
  }
}
